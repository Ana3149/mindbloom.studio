{
  "name": "mindbloom-studio",
  "private": true,
  "description": "MindBloom Studio static site",
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o assets/site.css --minify && node scripts/build-worker.mjs",
    "watch": "tailwindcss -i src/styles.css -o assets/site.css --watch",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "tailwindcss": "3.4.16",
    "wrangler": "4.160.1"
  }
}
